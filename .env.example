# Salin file ini menjadi ".env" (JANGAN di-commit ke GitHub).
# Tanpa awalan VITE_ agar tidak masuk ke bundle frontend.
# Kosongkan bila belum punya key: asisten otomatis memakai analisis berbasis aturan (bukan AI).
ANTHROPIC_API_KEY=
# Opsional:
# ASSISTANT_MODEL=
# ASSISTANT_API_BASE=

# --- Database (Supabase / PostgreSQL) ---
# Kunci PUBLIK (anon/publishable), aman berada di frontend. JANGAN isi service_role/secret di sini.
# Kosongkan bila belum punya: aplikasi memakai localStorage saja (diberi label di Pengaturan).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
